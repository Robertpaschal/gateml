// ─── Prisma Schema — GateML ────────────────────────────────────────────────
// Provider: PostgreSQL (production) | switch url to sqlite for local if needed
// Run:  npx prisma migrate dev --name init
// ───────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ─────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  ANALYST
}

enum MessageStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ContactCategory {
  SUPPORT
  ENTERPRISE_LEAD
  GENERAL
}

// ── Admin ─────────────────────────────────────────────────────────────────────

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   // null until invite is accepted
  name          String
  role          AdminRole @default(SUPPORT)
  isActive      Boolean   @default(true)
  inviteToken   String?   @unique
  inviteExpiry  DateTime?
  invitedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  invitedByAdmin AdminUser?  @relation("AdminInvites", fields: [invitedBy], references: [id])
  invitees       AdminUser[] @relation("AdminInvites")
  auditLogs      AuditLog[]
}

// ── Admin domain allowlist ────────────────────────────────────────────────────

model AdminDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // e.g. "gateml.com"
  createdAt DateTime @default(now())
}

// ── Audit log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  userId     String?
  action     String   // e.g. "user.plan_changed", "admin.login", "key.created"
  resource   String   // e.g. "user", "apiKey", "contactMessage"
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id])

  @@index([resource, resourceId])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model User {
  id                       String    @id @default(cuid())
  firebaseUid              String?   @unique
  email                    String    @unique
  name                     String?
  avatarUrl                String?
  provider                 String    // "google" | "github" | "apple" | "email"
  plan                     Plan      @default(FREE)
  stripeCustomerId         String?   @unique
  payAsYouGo               Boolean   @default(false)
  useManaged               Boolean   @default(false)

  // In-house email/password auth (optional — null for OAuth-only users)
  passwordHash             String?
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpiry  DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpiry      DateTime?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  apiKeys         ApiKey[]
  providerKeys    ProviderKey[]
  requestLogs     RequestLog[]
  prompts         Prompt[]
  subscription    Subscription?
  usageRecords    UsageRecord[]
  contactMessages ContactMessage[]
}

// ── Support Messages ──────────────────────────────────────────────────────────

model ContactMessage {
  id        String          @id @default(cuid())
  userId    String?
  email     String
  name      String
  company   String?
  subject   String
  body      String          @db.Text
  category  ContactCategory @default(SUPPORT)
  status    MessageStatus   @default(OPEN)
  replyBody String?         @db.Text
  repliedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([category, status, createdAt(sort: Desc)])
}

// ── Billing ───────────────────────────────────────────────────────────────────

model Subscription {
  id                 String   @id @default(cuid())
  userId             String   @unique
  stripeSubId        String   @unique
  stripePriceId      String
  status             String   // "active" | "past_due" | "canceled" | "trialing"
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId         String
  month          String   // "2026-06" — calendar month bucket
  requests       Int      @default(0)
  tokensUsed     Int      @default(0)
  managedCostUsd Float    @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

// ── API Keys ─────────────────────────────────────────────────────────────────

enum KeyType {
  TEST  // Returns synthetic responses; no real LLM calls
  LIVE  // Forwards to real providers using stored provider keys
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  key        String    @unique       // gml-sk-test_... or gml-sk-live_...
  keyPrefix  String                  // First 16 chars — safe to display
  type       KeyType
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestLogs RequestLog[]

  @@index([userId])
  @@index([key])
}

// ── Provider Keys ─────────────────────────────────────────────────────────────

enum LLMProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

model ProviderKey {
  id           String      @id @default(cuid())
  userId       String
  provider     LLMProvider
  keyEncrypted String      // AES-256-GCM encrypted
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ── Request Logs ──────────────────────────────────────────────────────────────

model RequestLog {
  id               String   @id @default(cuid())
  apiKeyId         String
  userId           String
  model            String
  provider         String   // "openai" | "anthropic" | "google" | "mock"
  status           Int
  latencyMs        Int
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  path             String
  isTestMode       Boolean  @default(false)
  createdAt        DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([apiKeyId])
}

// ── Prompts & Versions ────────────────────────────────────────────────────────

model Prompt {
  id        String          @id @default(cuid())
  userId    String
  name      String
  model     String          @default("gpt-4o")
  status    String          @default("draft") // draft | staging | production
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions PromptVersion[]

  @@index([userId])
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String
  version   Int
  body      String   @db.Text
  note      String   @default("")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
}
