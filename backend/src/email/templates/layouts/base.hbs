<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{{subject}}</title>
  <style>
    body { margin:0; padding:0; background:#0a0a0a; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#e5e5e5; }
    .wrapper { width:100%; max-width:600px; margin:0 auto; padding:40px 20px; }
    .card { background:#141414; border:1px solid #262626; border-radius:12px; overflow:hidden; }
    .header { background:#0f0f0f; border-bottom:1px solid #262626; padding:24px 32px; text-align:center; }
    .logo { font-size:20px; font-weight:700; color:#ffffff; letter-spacing:-0.5px; }
    .logo span { color:#a78bfa; }
    .body { padding:32px; }
    .footer { padding:24px 32px; border-top:1px solid #1a1a1a; text-align:center; }
    .footer p { margin:4px 0; font-size:12px; color:#555; }
    .footer a { color:#7c5cbf; text-decoration:none; }
    h1 { font-size:22px; font-weight:600; color:#ffffff; margin:0 0 8px; }
    p { font-size:15px; line-height:1.6; color:#b3b3b3; margin:0 0 16px; }
    p:last-child { margin-bottom:0; }
    .btn { display:inline-block; padding:12px 24px; background:#7c3aed; color:#ffffff !important; text-decoration:none; border-radius:8px; font-size:14px; font-weight:600; margin:8px 0; }
    .btn:hover { background:#6d28d9; }
    .highlight { background:#1a1a2e; border-left:3px solid #7c3aed; padding:12px 16px; border-radius:0 6px 6px 0; margin:16px 0; }
    .code { font-family:'Courier New',monospace; font-size:13px; color:#a78bfa; background:#1a1a1a; padding:2px 6px; border-radius:4px; }
    .divider { border:none; border-top:1px solid #262626; margin:20px 0; }
    .badge { display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; }
    .badge-purple { background:#3b0764; color:#c4b5fd; }
    .badge-green  { background:#052e16; color:#86efac; }
    .badge-yellow { background:#1c1007; color:#fde68a; }
    .badge-red    { background:#2d0a0a; color:#fca5a5; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="header">
        <div class="logo">Gate<span>ML</span></div>
      </div>
      <div class="body">
        {{{body}}}
      </div>
      <div class="footer">
        <p>© {{year}} GateML · <a href="{{appUrl}}">app.gateml.com</a></p>
        <p>You received this email because of activity on your account.</p>
        {{#if unsubscribeUrl}}<p><a href="{{unsubscribeUrl}}">Unsubscribe</a></p>{{/if}}
      </div>
    </div>
  </div>
</body>
</html>
