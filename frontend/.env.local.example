# ─── GateML Frontend — Environment Variables ──────────────────────────────────
# Copy to .env.local and fill in your values.
# All NEXT_PUBLIC_* vars are embedded in the browser bundle — DO NOT put secrets here.

# Backend API (proxied via Next.js rewrites in development)
# In production, set this to your EC2 backend URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Firebase Client SDK ────────────────────────────────────────────────────────
# 1. Go to Firebase Console → Project Settings → General → Your apps → Web app
# 2. Copy the firebaseConfig values below
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ── FCM Push Notifications ─────────────────────────────────────────────────────
# 1. Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# 2. Generate a key pair and copy the "Key pair" value (starts with BN...)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# ── Stripe (billing) ──────────────────────────────────────────────────────────
# Stripe Dashboard → Products → your Pro plans → Price ID
# These are public (publishable-key equivalent) — safe to expose in the browser
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=price_...
