# ─── GateML Frontend — Environment Variables ──────────────────────────────────
# Copy to .env.local and fill in your values.
# All NEXT_PUBLIC_* vars are embedded in the browser bundle — DO NOT put secrets here.

# Backend API (proxied via Next.js rewrites in development)
# In production, set this to your EC2 backend URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Firebase Client SDK ────────────────────────────────────────────────────────
# 1. Go to Firebase Console → Project Settings → General → Your apps → Web app
# 2. Copy the firebaseConfig values below
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
